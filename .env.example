# API Key do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Modelos Gemini (confira os nomes disponíveis na doc oficial antes de rodar)
GOOGLE_EMBEDDING_MODEL=models/gemini-embedding-001
GOOGLE_LLM_MODEL=gemini-3.6-flash

# Conexão com o Postgres subido via docker-compose.yml
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag

# Nome da "collection" (tabela lógica) usada pelo PGVector dentro do banco
PGVECTOR_COLLECTION=pdf_documents

# Caminho do PDF que será ingerido
PDF_PATH=document.pdf
